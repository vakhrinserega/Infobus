    "Используется, чтобы показать вас на карте и подсветить вашу остановку на схеме маршрута.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to show your location on the map and highlight your stop on the route diagram."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картада өзіңізді көрсету және бағыт схемасында аялдамаңызды белгілеу үшін пайдаланылады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется, чтобы показать вас на карте и подсветить вашу остановку на схеме маршрута."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовується, щоб показати вас на карті та підсвітити вашу зупинку на схемі маршруту."
          }
        }
      }
    },
